{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "endOfLine": "lf",
  "bracketSpacing": true,
  "arrowParens": "always",
  "plugins": ["@trivago/prettier-plugin-sort-imports"],
  "importOrder": [
    "^react$|^react-dom(/.*)?$",
    "^next(/.*)?$",
    "<THIRD_PARTY_MODULES>",
    "^@/components(/.*)?$",
    "^@/hooks(/.*)?$",
    "^@/store(/.*)?$",
    "^@/services(/.*)?$",
    "^@/config(/.*)?$|^@/constants(/.*)?$",
    "^@/i18n(/.*)?$",
    "^@/types(/.*)?$",
    "^@/utils(/.*)?$",
    "^[.]"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true
}
